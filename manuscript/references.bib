@Article{	  hu2025583,
  abstract	= {To cope with the ever-increasing number of used cars, many
		  automobile manufacturers now offer trade-in programs
		  whereby they resell used cars to generate revenue.
		  Consumers have the alternative of selling their used cars
		  via an online peer-to-peer (P2P) resale platform, which
		  charges a commission on each transaction. This paper
		  studies a manufacturer's traded-in resale strategy and
		  assess how the manufacturer's resale strategy and profits
		  are affected by the presence of online P2P platforms. We
		  find that in the absence of P2P platforms, the manufacturer
		  may opt against implementing a resale program, whereas it
		  will always do so in the presence of P2P platforms. This
		  suggests a notable shift in manufacturers' optimal choice
		  of trade-in resale strategies due to the emergence of P2P
		  platforms. Furthermore, the study reveals that the
		  introduction of P2P platforms may diminishes the profits of
		  manufacturers who have implemented a resale program.
		  Importantly, the study underscores that manufacturers are
		  not necessarily obliged to adopt a planned obsolescence
		  strategy. When P2P platforms are absent, implementing a
		  resale program allows manufacturers to increase profits by
		  producing products that are either less or more durable.
		  However, in the face of competition from P2P platforms,
		  profitability can only be enhanced by making products more
		  durable. This suggests that a platform's emergence can
		  alter how the depreciation rate affects a manufacturer's
		  profit and hence its optimal product design strategies.
		  Understanding these dynamics is crucial for effectively
		  navigating the growing used car market.},
  author	= {Shu Hu and Stuart X. Zhu and Ke Fu},
  doi		= {https://doi.org/10.1016/j.ejor.2024.12.017},
  issn		= {0377-2217},
  journal	= {European Journal of Operational Research},
  keywords	= {Trade-ins, Resale strategy, Online P2P resale platform,
		  Strategic consumers, Durable products},
  number	= {2},
  pages		= {583-598},
  title		= {The manufacturer's resale strategy for trade-ins},
  volume	= {323},
  year		= {2025},
  bdsk-url-1	= {https://www.sciencedirect.com/science/article/pii/S0377221724009597},
  bdsk-url-2	= {https://doi.org/10.1016/j.ejor.2024.12.017}
}


@misc{zacharof,
    key = {Zacharof},
	number = {KJ-01-24-251-EN-N (online)},
	address = {Luxembourg (Luxembourg)},
	issn = {1831-9424 (online)},
	year = {2025},
	author	= {Zacharof, Nikiforos and Nur, Jamil and Kourtesis, Dimitrios and Krause, Jette and Fontaras, Georgios},
	isbn = {978-92-68-23589-8 (online)},
	publisher = {Publications Office of the European Union},
	abstract = {The European fleet of passenger cars is increasing in size and rapidly ageing. A larger stock of older vehicles introduces a legacy effect limiting the adoption of newer cars, thus slowing down the transition towards more fuel-efficient and less polluting ones. Yet, little is known about the characteristics of the used vehicle market in Europe. This report contributes to filling this gap by providing an integrated analysis of the EU-27 used light-duty vehicle market. First, it summarizes the major challenges observed in the analysis of macro-scale sale statistics of used vehicles – trade flows between Member States and from and to third countries. Second, it sources new data on used vehicle characteristics from Member State vehicle agencies, providing an additional focus on the emerging second-hand market for electric vehicles. Analysis of the four largest EU passenger car markets – France, Germany, Italy and Spain – revealed that the vehicle fleet has aged substantially between 2007 and 2023 and that different countries are characterised by different trends in the used market. A growing market of used electrified vehicles was equally identified, with substantial variation across Member States.},
	title = {A review of the used car market in the European Union},
	doi = {https://doi.org/10.2760/3237256}
}

